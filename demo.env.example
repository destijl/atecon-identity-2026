# Demo settings. Copy to demo.env (git-ignored) and fill in.
#   cp demo.env.example demo.env && $EDITOR demo.env && scripts/setup.sh

# --- Who and where ------------------------------------------------------
# Google Cloud project for the cluster, images, Cloud Run and Auth Manager.
export PROJECT_ID="your-project-id"
export REGION="us-central1"

# The Google account whose mail the agent reads (must be a test user on the
# OAuth consent screen). It is only sent to Google as a login hint.
export DEMO_EMAIL="you@gmail.com"
# The name the demo shows on screen and derives the atespace from.
export DISPLAY_EMAIL="alice@gmail.com"

# --- GKE cluster (created by scripts/setup.sh if missing) ---------------
export CLUSTER_NAME="substrate-oauth-demo"
export CLUSTER_LOCATION="us-central1-a"
export GKE_VERSION="1.37.1-gke.1552000"
export NODE_MACHINE_TYPE="c3-standard-4"
export NODE_COUNT="2"

# --- Artifact Registry repo for demo and Substrate images ---------------
export IMAGE_REPO_NAME="substrate-oauth-demo"
export IMAGE_REPO="${REGION}-docker.pkg.dev/${PROJECT_ID}/${IMAGE_REPO_NAME}"

# --- Agent Auth Manager 3-legged OAuth provider -------------------------
export AUTH_PROVIDER_NAME="gmail-connector"
export AUTH_PROVIDER="projects/${PROJECT_ID}/locations/${REGION}/authProviders/${AUTH_PROVIDER_NAME}"

# --- Substrate ----------------------------------------------------------
export SUBSTRATE_REPO="https://github.com/agent-substrate/substrate"
export SUBSTRATE_COMMIT="274605f1"
# Optional: an existing checkout at SUBSTRATE_COMMIT. Default: clone into .cache/.
# export SUBSTRATE_DIR="${HOME}/src/substrate"
export SNAPSHOT_BUCKET="${PROJECT_ID}-substrate-snapshots"
export SNAPSHOT_LOCATION="gs://${SNAPSHOT_BUCKET}/"
export SNAPSHOT_TRANSFER_GSA_NAME="ate-snapshot-transfer"

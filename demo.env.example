# Demo settings. Copy to demo.env and edit. demo.env is git-ignored.
#
# DEMO_EMAIL is the Google account whose mail the agent reads. Code, prompts
# and slides say alice@gmail.com; set the real test account here.
export DEMO_EMAIL="alice@gmail.com"

# Name shown on screen. Keep it as alice@gmail.com so the recording never
# shows the real address, even when DEMO_EMAIL is your account.
export DISPLAY_EMAIL="alice@gmail.com"

export PROJECT_ID="gcastle-testing-402921"
export CLUSTER_NAME="substrate-gateway-test"
export CLUSTER_LOCATION="us-central1-c"
export REGION="us-central1"
export IMAGE_REPO="us-central1-docker.pkg.dev/${PROJECT_ID}/atecon-demo"

# Agent Auth Manager 3LO provider (created once; see INFRA_SETUP.md).
export AUTH_PROVIDER="projects/${PROJECT_ID}/locations/${REGION}/authProviders/gmail-connector"

# Substrate build to install.
export SUBSTRATE_COMMIT="274605f1"
export SUBSTRATE_DIR="${HOME}/gemini-workspaces/substrate-wt-atecon-oauth-demo"
export SNAPSHOT_LOCATION="gs://snapshot-substrate-gateway-test-${PROJECT_ID}/"
export SNAPSHOT_TRANSFER_GSA_NAME="ate-snapshot-transfer"

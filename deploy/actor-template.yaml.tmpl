# ActorTemplate (protojson ateapi.ActorTemplate) for the email agent.
# One template per user atespace; rendered by scripts/up.sh.
metadata:
  atespace: ${ATESPACE}
  name: email-agent
workerSelector:
  matchLabels:
    workload: email-agent
containers:
- name: agent
  image: ${AGENT_IMAGE}
  command:
  - /app
  - --address=:80
  env:
  # The only things the agent is given: a CA bundle that trusts the egress
  # gateway's TLS interception, and where the email app is. No credentials.
  - name: SSL_CERT_FILE
    value: /run/ate/egress-trust-bundle/trust-bundle.pem
  volumeMounts:
  - name: system-info
    mountPath: /run/ate
  wakeupProbe:
    httpGet:
      path: /readyz
      port: 80
volumes:
- name: system-info
  systemInfo:
    dataSources:
    - trustBundle:
        names:
        - egress-mitm.ate.dev
        - system-roots.ate.dev
        path: egress-trust-bundle/trust-bundle.pem
resources:
  limits:
    cpuMillicores: 500
    memoryBytes: 268435456 # 256Mi
